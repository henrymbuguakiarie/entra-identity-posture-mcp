# Auto detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Explicit overrides for common text files
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts should keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files should never be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
